# Site URL used in page metadata and the sitemap.
# Use your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase settings for accounts and saved estimates.
# These keys are public. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The older anon-key variable name also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional private API key for international VIN fallback (CarsXE).
# Keep this server-side. Do not rename it with a NEXT_PUBLIC_ prefix.
CARSXE_API_KEY=
# Optional private API key for Japanese domestic frame/chassis lookup (Cardog).
# Keep this server-side. Do not rename it with a NEXT_PUBLIC_ prefix.
CARDOG_API_KEY=
