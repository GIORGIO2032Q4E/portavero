# Site URL used in page metadata and the sitemap.
# Use your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase settings for accounts and saved estimates.
# These keys are public. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The older anon-key variable name also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
