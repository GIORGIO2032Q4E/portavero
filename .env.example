# Public base URL used for metadata, robots.txt and sitemap.xml
# Set this to your real production domain when one is configured.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings for sign-in, sign-up and saved estimates.
# These are public browser values. Never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key name is also supported if already configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
